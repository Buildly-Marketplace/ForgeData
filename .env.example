# ForgeData Configuration Example
# Copy this file to .env and update with your values

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=true
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=sqlite:///./forgedata.db

# =============================================================================
# Security
# =============================================================================
# Generate a secure secret key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=change-this-to-a-secure-random-string

# Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Authentication
# =============================================================================
# Configure your authentication provider settings here
# Leave empty for development mode (uses mock authentication)
AUTH_API_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# =============================================================================
# Google Cloud Platform
# =============================================================================
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=
GCS_BACKUP_BUCKET=

# Database Connection (for backup/restore)
GCP_DB_HOST=
GCP_DB_NAME=
GCP_DB_USER=
GCP_DB_PASSWORD=
GCP_DB_PORT=5432

# Example:
# GCP_PROJECT_ID=my-gcp-project
# GCP_CREDENTIALS_PATH=/path/to/gcp-service-account.json
# GCS_BACKUP_BUCKET=my-database-backups
# GCP_DB_HOST=35.239.201.185
# GCP_DB_NAME=gmb
# GCP_DB_USER=postgres
# GCP_DB_PASSWORD=your_secure_password

# =============================================================================
# Amazon Web Services
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# AWS RDS Connection (for restore)
AWS_DB_HOST=
AWS_DB_NAME=
AWS_DB_USER=
AWS_DB_PASSWORD=
AWS_DB_PORT=5432

# =============================================================================
# Digital Ocean
# =============================================================================
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_REGION=nyc3

# =============================================================================
# ETL Settings
# =============================================================================
ETL_BATCH_SIZE=1000
ETL_MAX_WORKERS=4
ANONYMIZATION_ENABLED=true
DEDUPLICATION_ENABLED=true

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
